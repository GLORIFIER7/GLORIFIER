# Set a long random value in deployment secrets; never commit real credentials.
GLORIFIER_API_TOKEN=
GLORIFIER_REQUIRE_API_TOKEN=true
# Local development defaults: provider access and inference stay disabled.
GLORIFIER_PROVIDER=openai
GLORIFIER_ALLOW_EXTERNAL_DATA_EGRESS=false
GLORIFIER_ENABLE_INFERENCE=false
GLORIFIER_PAID_INFERENCE_AUTHORIZED=false
OPENAI_MODEL=gpt-6-luna

# Leave blank locally unless you intentionally configure the integration.
OPENAI_API_KEY=

# Optional Google Gemini Interactions API provider.
# Runtime provider selection: GLORIFIER_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Optional Anthropic Claude Messages API provider.
# Runtime provider selection: GLORIFIER_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

GLORIFIER_NEON_CONNECTIVITY_ENABLED=false
NEON_DATABASE_URL=

# Optional self-hosted NVIDIA Dynamo frontend. Set these in the runtime secret manager.
# Use the exact OpenAI-compatible API root and the exact HTTPS origin that owns it.
NVIDIA_DYNAMO_BASE_URL=
NVIDIA_DYNAMO_ALLOWED_ORIGIN=
NVIDIA_DYNAMO_API_KEY=
NVIDIA_DYNAMO_MODEL=
