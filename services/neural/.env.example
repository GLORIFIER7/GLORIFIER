# Set a long random value in deployment secrets; never commit real credentials.
GLORIFIER_API_TOKEN=
GLORIFIER_REQUIRE_API_TOKEN=true
# Local development defaults: provider access and inference stay disabled.
GLORIFIER_PROVIDER=openai
GLORIFIER_ALLOW_EXTERNAL_DATA_EGRESS=false
GLORIFIER_ENABLE_INFERENCE=false
OPENAI_MODEL=gpt-6-luna

# Leave blank locally unless you intentionally configure the integration.
OPENAI_API_KEY=
GLORIFIER_NEON_CONNECTIVITY_ENABLED=false
NEON_DATABASE_URL=
