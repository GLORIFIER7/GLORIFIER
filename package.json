{
  "name": "@glorifier7/glorifier",
  "private": false,
  "version": "0.2.1",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "npm run build:frontend",
    "start": "tsx server.ts",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "build:frontend": "vite build",
    "build:android": "cross-env CAPACITOR_BUILD=true vite build",
    "android:sync": "npm run build:android && npx cap sync android",
    "android:open": "npx cap open android",
    "build:server": "esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "test:harness": "tsx src/lib/ai/agent-harness.test.ts",
    "test:architecture": "tsx src/lib/governance/architecture-core.test.ts",
    "test:geas-reconciliation": "tsx src/lib/governance/geas-reconciliation.test.ts",
    "test:permanent-stack": "tsx src/lib/governance/permanent-stack.test.ts",
    "test:agent-miner": "tsx src/lib/agent-miner.test.ts",
    "test:geas-controls": "tsx src/lib/governance/geas-architecture-controls.test.ts",
    "daemon:run": "tsx src/lib/glorifier-daemon.ts",
    "test:anthropic": "tsx src/lib/ai/providers/anthropic.test.ts",
    "test:geas-enterprise-controls": "tsx src/lib/governance/geas-enterprise-controls.test.ts",
    "test:geas-all": "npm run test:geas-reconciliation && npm run test:geas-enterprise-controls",
    "test:internet-discovery": "tsx src/lib/internet-discovery-fabric.test.ts",
    "test:model-network": "tsx src/lib/model-network.test.ts",
    "test:ai-web-network": "tsx src/lib/ai-web-network.test.ts",
    "test:federated-a2a-v3": "tsx src/lib/federated-a2a-v3.test.ts"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/core": "^8.0.0",
    "@google/genai": "^2.24.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "dotenv": "^18.0.4",
    "express": "^4.21.2",
    "firebase": "^12.19.0",
    "firebase-admin": "^14.5.0",
    "lucide-react": "^0.546.0",
    "mongodb": "^7.7.0",
    "motion": "^12.23.24",
    "openai": "^7.25.0",
    "pg": "^8.16.3",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "vite": "^8.3.1",
    "tsx": "^4.21.0",
    "@capacitor/device": "^8.0.3"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.3",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.6.1",
    "esbuild": "^0.28.2",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "@capacitor/cli": "^8.5.2",
    "cross-env": "^10.1.0",
    "playwright": "^1.63.0",
    "@playwright/test": "^1.55.0"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "files": [
    "dist",
    "src",
    "server.ts",
    "package.json",
    "tsconfig.json",
    "vite.config.ts",
    "index.html",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/GLORIFIER7/GLORIFIER.git"
  },
  "homepage": "https://github.com/GLORIFIER7/GLORIFIER",
  "bugs": {
    "url": "https://github.com/GLORIFIER7/GLORIFIER/issues"
  },
  "license": "Apache-2.0",
  "overrides": {
    "@grpc/grpc-js": "^1.14.5",
    "uuid": "^11.1.1"
  }
}
