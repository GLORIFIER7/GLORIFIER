# Reproducible application compatibility runtime.
# Keep the Node.js build inputs pinned; use Debian unstable only as the runtime
# package source until the CVE-2026-76844 backport reaches a supported release.
FROM node@sha256:c86ecead9e55a5210ac1727de38a4ca840bf03dcaf34dc9749addbf383b1920c AS node-bins

FROM node@sha256:c86ecead9e55a5210ac1727de38a4ca840bf03dcaf34dc9749addbf383b1920c AS build-deps
WORKDIR /app
COPY package*.json ./
RUN npm ci --no-audit --no-fund --ignore-scripts

FROM build-deps AS build
COPY . .
RUN npm run build

FROM node@sha256:c86ecead9e55a5210ac1727de38a4ca840bf03dcaf34dc9749addbf383b1920c AS production-deps
WORKDIR /app
COPY package*.json ./
RUN npm ci --omit=dev --no-audit --no-fund --ignore-scripts

FROM debian:unstable-slim AS runtime
ENV DEBIAN_FRONTEND=noninteractive \
    NODE_ENV=production \
    NPM_CONFIG_UPDATE_NOTIFIER=false \
    NPM_CONFIG_FUND=false

# Require the Debian zlib package containing both gzwrite security fixes.
RUN set -eux; \
    apt-get update; \
    apt-get install -y --no-install-recommends \
      ca-certificates \
      libatomic1 \
      libgcc-s1 \
      libssl3t64 \
      libstdc++6 \
      passwd \
      zlib1g; \
    zlib_version="$(dpkg-query -W -f='${Version}' zlib1g)"; \
    dpkg --compare-versions "$zlib_version" ge '1:1.3.dfsg+really1.3.2-4'; \
    rm -rf /var/lib/apt/lists/*; \
    groupadd --system --gid 10001 app; \
    useradd --system --uid 10001 --gid app --home-dir /app --shell /usr/sbin/nologin app; \
    mkdir -p /app; \
    chown 10001:10001 /app

COPY --from=node-bins /usr/local/bin/node /usr/local/bin/node
RUN /usr/local/bin/node -e 'const [major, minor] = process.versions.node.split(".").map(Number); if (major < 24 || (major === 24 && minor < 12)) process.exit(1)' 
WORKDIR /app
COPY --from=production-deps --chown=10001:10001 /app/node_modules ./node_modules
COPY --from=build --chown=10001:10001 /app/dist ./dist
COPY --from=build --chown=10001:10001 /app/src ./src
COPY --from=build --chown=10001:10001 /app/server.ts ./server.ts
COPY --from=build --chown=10001:10001 /app/package.json ./package.json

USER 10001:10001
EXPOSE 3000
CMD ["node", "dist/server.cjs"]
