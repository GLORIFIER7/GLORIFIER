{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "glorifier",
  "compatibility_date": "2026-10-12",
  "vars": {
    "GLORIFIER_SUPABASE_URL": "https://ymbhbxrobfpqlxhyulbt.supabase.co"
  },
  "secrets": {
    "required": [
      "GLORIFIER_SUPABASE_SERVICE_ROLE_KEY",
      "OPENSEA_API_KEY"
    ]
  },
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api",
      "/api/*",
      "/auth",
      "/auth/*",
      "/assets/*",
      "/*.js",
      "/*.mjs",
      "/*.css",
      "/*.map",
      "/*.png",
      "/*.jpg",
      "/*.jpeg",
      "/*.gif",
      "/*.svg",
      "/*.webp",
      "/*.ico",
      "/*.woff",
      "/*.woff2",
      "/*.ttf",
      "/*.otf",
      "/*.json",
      "/*.webmanifest"
    ]
  },
  "previews": {},
  "main": "./src/worker.ts"
}
