{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "glorifier",
  "compatibility_date": "2026-10-12",
  "vars": {
    "GLORIFIER_SUPABASE_URL": "https://ymbhbxrobfpqlxhyulbt.supabase.co",
    "GLORIFIER_DATABASE_PROVIDER": "neon"
  },
  "secrets": {
    "required": [
      "GLORIFIER_SUPABASE_SERVICE_ROLE_KEY",
      "OPENSEA_API_KEY"
    ]
  },
  "ratelimits": [
    {
      "name": "MCP_RATE_LIMITER",
      "namespace_id": "2026110101",
      "simple": {
        "limit": 10,
        "period": 60
      }
    }
  ],
  "version_metadata": {
    "binding": "CF_VERSION_METADATA"
  },
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "eff847b6c3c64488a989f1fa67d966a0"
    }
  ],
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api",
      "/api/*",
      "/auth",
      "/auth/*",
      "/mcp",
      "/mcp/*",
      "/assets/*",
      "/*.js",
      "/*.mjs",
      "/*.css",
      "/*.map",
      "/*.png",
      "/*.jpg",
      "/*.jpeg",
      "/*.gif",
      "/*.svg",
      "/*.webp",
      "/*.ico",
      "/*.woff",
      "/*.woff2",
      "/*.ttf",
      "/*.otf",
      "/*.json",
      "/*.webmanifest"
    ]
  },
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "invocation_logs": true,
      "head_sampling_rate": 0.1
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    },
    "issues": {
      "enabled": true
    }
  },
  "previews": {
    "vars": {
      "GLORIFIER_DATABASE_PROVIDER": "neon"
    }
  },
  "main": "./src/worker.ts",
  "compatibility_flags": [
    "nodejs_compat"
  ]
}
