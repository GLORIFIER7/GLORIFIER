{
  "buildCommand": "npm run build:frontend",
  "outputDirectory": "dist",
  "installCommand": "npm install",
  "ignoreCommand": "if [ -n \"$VERCEL_GIT_PREVIOUS_SHA\" ] && git cat-file -e \"$VERCEL_GIT_PREVIOUS_SHA^{commit}\" 2>/dev/null; then if git diff --quiet \"$VERCEL_GIT_PREVIOUS_SHA\" \"$VERCEL_GIT_COMMIT_SHA\" -- . ':!.github' ':!solana'; then exit 0; else exit 1; fi; else exit 1; fi",
  "framework": "vite",
  "git": {
    "deploymentEnabled": true
  },
  "routes": [
    {
      "src": "^/api/health$",
      "dest": "/api/health.js"
    },
    {
      "src": "^/api/provider-health$",
      "dest": "/api/provider-health.js"
    },
    {
      "src": "^/api/(.*)$",
      "dest": "https://glorifier-artificial-intelligence-production.up.railway.app/api/$1"
    },
    {
      "src": "^/auth/(.*)$",
      "dest": "https://glorifier-artificial-intelligence-production.up.railway.app/auth/$1"
    },
    {
      "handle": "filesystem"
    }
  ],
  "env": {
    "VITE_API_BASE_URL": "https://glorifier-artificial-intelligence-production.up.railway.app"
  }
}
