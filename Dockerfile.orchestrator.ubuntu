# GLORIFIER Permanent Orchestrator — minimal non-root runtime.
# Keep the Node.js runtime binary pinned; enforce a Debian zlib package that
# contains the upstream fix for CVE-2026-76844 and CVE-2026-85091.
FROM node@sha256:c86ecead9e55a5210ac1727de38a4ca840bf03dcaf34dc9749addbf383b1920c AS node-bins

FROM debian:unstable-slim AS runtime
ENV DEBIAN_FRONTEND=noninteractive \
    NODE_ENV=production

RUN set -eux; \
    apt-get update; \
    apt-get install -y --no-install-recommends \
      ca-certificates \
      libatomic1 \
      libgcc-s1 \
      libssl3t64 \
      libstdc++6 \
      passwd \
      zlib1g; \
    zlib_version="$(dpkg-query -W -f='${Version}' zlib1g)"; \
    dpkg --compare-versions "$zlib_version" ge '1:1.3.dfsg+really1.3.2-4'; \
    rm -rf /var/lib/apt/lists/*; \
    groupadd --system --gid 10001 glorifier; \
    useradd --system --uid 10001 --gid glorifier --home-dir /app --no-create-home --shell /usr/sbin/nologin glorifier; \
    mkdir -p /app/scripts; \
    chown -R 10001:10001 /app

COPY --from=node-bins /usr/local/bin/node /usr/local/bin/node

RUN node -e 'const [major, minor] = process.versions.node.split(".").map(Number); if (major < 24 || (major === 24 && minor < 12)) process.exit(1); console.log("Verified Node.js " + process.versions.node)'

WORKDIR /app
COPY scripts/permanent-orchestrator.mjs ./scripts/permanent-orchestrator.mjs
RUN node --check ./scripts/permanent-orchestrator.mjs

USER 10001:10001
CMD ["node", "scripts/permanent-orchestrator.mjs"]
