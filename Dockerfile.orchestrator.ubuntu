# GLORIFIER Permanent Orchestrator — reproducible Ubuntu LTS runtime
# Both the OS image and the official Node runtime source are pinned by digest.
FROM node:24.22.2-bookworm-slim@sha256:c86ecead9e55a5210ac1727de38a4ca840bf03dcaf34dc9749addbf383b1920c AS node-bins

FROM ubuntu:24.04@sha256:534baea6a22c03a63003dbc8dbe78fe34bc0d7e595d9a9dc9834884ff530eb55 AS runtime

ENV DEBIAN_FRONTEND=noninteractive \
    NODE_ENV=production \
    NPM_CONFIG_UPDATE_NOTIFIER=false \
    NPM_CONFIG_FUND=false

COPY docker/orchestrator-security-patches/package.json docker/orchestrator-security-patches/package-lock.json /tmp/npm-security-patches/

# Install the shared libraries required by the official Node binary copied from Debian.
RUN apt-get update \
 && apt-get install -y --no-install-recommends ca-certificates git libstdc++6 libgcc-s1 libatomic1 libssl3t64 zlib1g passwd \
 && apt-get clean \
 && rm -rf /var/lib/apt/lists/*

# Copy Node and npm from the pinned official Node image; do not execute a remote
# repository bootstrap script inside the production image build.
COPY --from=node-bins /usr/local/bin/node /usr/local/bin/node
COPY --from=node-bins /usr/local/bin/npm /usr/local/bin/npm
COPY --from=node-bins /usr/local/bin/npx /usr/local/bin/npx
COPY --from=node-bins /usr/local/lib/node_modules/npm /usr/local/lib/node_modules/npm

RUN /usr/local/bin/node -e 'const [major, minor] = process.versions.node.split(".").map(Number); if (major < 24 || (major === 24 && minor < 12)) process.exit(1)' \
 && npm install --global npm@12.2.1 --ignore-scripts --no-audit --no-fund \
 && npm ci --prefix /tmp/npm-security-patches --ignore-scripts --no-audit --no-fund \
 && mkdir -p /usr/lib/node_modules/npm/node_modules \
 && rm -rf /usr/lib/node_modules/npm/node_modules/undici /usr/lib/node_modules/npm/node_modules/brace-expansion /usr/lib/node_modules/npm/node_modules/balanced-match \
 && cp -a /tmp/npm-security-patches/node_modules/. /usr/lib/node_modules/npm/node_modules/ \
 && rm -rf /tmp/npm-security-patches \
 && node -e 'const root="/usr/lib/node_modules/npm/node_modules/"; const expected={"undici":"6.29.1","brace-expansion":"5.0.12","balanced-match":"4.0.4"}; for (const [name, version] of Object.entries(expected)) { const actual = require(root + name + "/package.json").version; if (actual !== version) throw new Error(name + " expected " + version + " but found " + actual); }' \
 && npm --version

WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --omit=dev --ignore-scripts --no-audit --no-fund
COPY scripts/permanent-orchestrator.mjs ./scripts/permanent-orchestrator.mjs
CMD ["node", "scripts/permanent-orchestrator.mjs"]
