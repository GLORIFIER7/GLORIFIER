# GLORIFIER Permanent Orchestrator — Ubuntu LTS runtime
# Ubuntu 24.04 LTS (Noble) + Node.js 24
FROM ubuntu:24.04

ENV DEBIAN_FRONTEND=noninteractive \
    NODE_ENV=production \
    NPM_CONFIG_UPDATE_NOTIFIER=false \
    NPM_CONFIG_FUND=false

RUN apt-get update \
 && apt-get install -y --no-install-recommends ca-certificates curl git \
 && curl -fsSL https://deb.nodesource.com/setup_24.x | bash - \
 && apt-get install -y --no-install-recommends nodejs \
 && node -e 'const [major, minor] = process.versions.node.split(".").map(Number); if (major < 24 || (major === 24 && minor < 15)) process.exit(1)' \
 && npm install --global npm@12.2.1 --ignore-scripts --no-audit --no-fund \
 && npm install --prefix /usr/lib/node_modules/npm undici@6.29.1 --no-save --ignore-scripts --no-audit --no-fund \
 && node -e 'const root="/usr/lib/node_modules/npm/node_modules/"; const expected={"undici":"6.29.1","brace-expansion":"5.0.12"}; for (const [name, version] of Object.entries(expected)) { const actual = require(root + name + "/package.json").version; if (actual !== version) throw new Error(name + " expected " + version + " but found " + actual); }' \
 && npm --version \
 && apt-get clean \
 && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --omit=dev --no-audit --no-fund
COPY scripts/permanent-orchestrator.mjs ./scripts/permanent-orchestrator.mjs
CMD ["node", "scripts/permanent-orchestrator.mjs"]
