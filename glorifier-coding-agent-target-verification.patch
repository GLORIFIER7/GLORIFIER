+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { verifyCodingTarget } from '../src/coding-target.mjs';
+const R='GLORIFIER7/GLORIFIER', API='https://api.github.com', SHA='a'.repeat(40), HEAD='b'.repeat(40);
+const env={GITHUB_REPOSITORY:R,GITHUB_EVENT_NAME:'issue_comment',GITHUB_REF:'refs/heads/main',GITHUB_ACTOR_ID:'32674233',GITHUB_TRIGGERING_ACTOR:'GLORIFIER7',GITHUB_SHA:SHA};
+const event={action:'created',repository:{full_name:R},sender:{id:32674233,type:'User'},issue:{number:471,state:'open'},comment:{id:1234,body:'/glorifier fix',user:{id:32674233,type:'User'}}};
+const issueUrl=API+'/repos/'+R+'/issues/471';
+const fixtures={ '/commits/main':{sha:SHA,commit:{verification:{verified:true,reason:'valid'}}}, '/issues/471':{number:471,state:'open',url:issueUrl}, '/issues/comments/1234':{id:1234,user:{id:32674233,type:'User'},body:'/glorifier fix',issue_url:issueUrl,created_at:'2026-11-24T00:00:00Z',updated_at:'2026-11-24T00:00:00Z'} };
+function mock(overrides={}){const calls=[];return {calls,fetcher:async(url,opts)=>{assert.equal(opts.method,'GET');assert.equal(opts.redirect,'error');assert.equal(opts.headers.Authorization,'Bearer fake-token');assert.ok(url.startsWith(API+'/repos/'+R+'/'));const p=url.slice((API+'/repos/'+R).length);calls.push(p); const data={...fixtures,...overrides}[p];return new Response(JSON.stringify(data??{}),{status:data?200:404})}};}
+const run=(m,e=event,x=env)=>verifyCodingTarget({env:x,event:e,token:'fake-token',fetcher:m.fetcher});
+test('valid owner issue yields pinned read-only evidence, not execution',async()=>{const m=mock();const out=await run(m);assert.equal(out.status,'TARGET_VERIFIED');assert.equal(out.sourceSnapshotSha,SHA);assert.equal(out.target.headSha,null);assert.equal(out.targetHeadVerified,false);assert.equal(out.executionAuthorized,false);assert.equal(out.paidInferenceAuthorized,false);assert.equal(out.fullyVerified,false);assert.equal(m.calls.length,3);assert.ok(!JSON.stringify(out).includes('/glorifier fix'));});
+test('unauthorized request makes no API calls',async()=>{const m=mock();assert.deepEqual(await run(m,event,{...env,GITHUB_ACTOR_ID:'1'}),{status:'IGNORED'});assert.equal(m.calls.length,0);});
+test('rejects stale or unsigned main',async()=>{for(const main of [{...fixtures['/commits/main'],sha:HEAD},{sha:SHA,commit:{verification:{verified:false}}}])await assert.rejects(run(mock({'/commits/main':main})),/main/);});
+test('rejects changed, deleted, edited or wrongly linked comments',async()=>{for(const c of [null,{...fixtures['/issues/comments/1234'],body:'/glorifier plan'},{...fixtures['/issues/comments/1234'],issue_url:issueUrl+'0'},{...fixtures['/issues/comments/1234'],updated_at:'2026-11-24T00:01:00Z'},{...fixtures['/issues/comments/1234'],user:{id:2,type:'User'}}])await assert.rejects(run(mock({'/issues/comments/1234':c})));});
+test('rejects closed or unexpectedly converted target',async()=>{for(const i of [{...fixtures['/issues/471'],state:'closed'},{...fixtures['/issues/471'],pull_request:{}}])await assert.rejects(run(mock({'/issues/471':i})),/target/);});
+test('same-repository PR readback pins exact head without granting permission',async()=>{const e=structuredClone(event);e.issue.pull_request={};const m=mock({'/issues/471':{...fixtures['/issues/471'],pull_request:{}},'/pulls/471':{number:471,state:'open',head:{sha:HEAD,repo:{full_name:R}},base:{ref:'main',repo:{full_name:R}}}});const out=await run(m,e);assert.equal(out.target.headSha,HEAD);assert.equal(out.targetHeadVerified,true);assert.equal(out.executionAuthorized,false);});
+test('fork or unexpected PR base is blocked',async()=>{const e=structuredClone(event);e.issue.pull_request={};for(const p of [{head:{sha:HEAD,repo:{full_name:'fork/repo'}},base:{ref:'main',repo:{full_name:R}}},{head:{sha:HEAD,repo:{full_name:R}},base:{ref:'other',repo:{full_name:R}}}])await assert.rejects(run(mock({'/issues/471':{...fixtures['/issues/471'],pull_request:{}},'/pulls/471':{number:471,state:'open',...p}}),e),/PR/);});
+test('missing token fails before API call',async()=>{const m=mock();await assert.rejects(verifyCodingTarget({env,event,fetcher:m.fetcher}),/token/);assert.equal(m.calls.length,0);});
