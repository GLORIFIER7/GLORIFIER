{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "GLORIFIER Governed A2A Task Envelope",
  "type": "object",
  "required": [
    "task_id",
    "lifecycle",
    "requester",
    "assignee",
    "authorization",
    "evidence_policy",
    "idempotency_key"
  ],
  "properties": {
    "task_id": {
      "type": "string",
      "minLength": 1
    },
    "protocol": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "const": "A2A"
        },
        "target_version": {
          "type": "string",
          "const": "1.0"
        },
        "conformance_status": {
          "type": "string",
          "enum": [
            "VERIFIED",
            "PARTIALLY_VERIFIED",
            "NOT_VERIFIED",
            "DEGRADED",
            "NOT_OBSERVABLE"
          ]
        }
      },
      "additionalProperties": false
    },
    "lifecycle": {
      "type": "string",
      "enum": [
        "DISCOVERED",
        "AUTHORIZED",
        "ASSIGNED",
        "RUNNING",
        "EVIDENCE",
        "VERIFIED",
        "SETTLED",
        "FAILED"
      ]
    },
    "requester": {
      "type": "string",
      "minLength": 1
    },
    "assignee": {
      "type": "string",
      "minLength": 1
    },
    "authorization": {
      "type": "object",
      "required": [
        "authorized",
        "reference"
      ],
      "properties": {
        "authorized": {
          "type": "boolean"
        },
        "reference": {
          "type": "string",
          "minLength": 1
        },
        "human_approval_required": {
          "type": "boolean"
        },
        "human_approval_record": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "idempotency_key": {
      "type": "string",
      "minLength": 1
    },
    "runtime_compatibility": {
      "type": "object",
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "FULLY_VERIFIED",
            "VERIFIED",
            "PARTIALLY_VERIFIED",
            "NOT_VERIFIED",
            "DEGRADED",
            "NOT_OBSERVABLE"
          ]
        },
        "runtime_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "runtime_version": {
          "type": [
            "string",
            "null"
          ]
        },
        "provider": {
          "type": [
            "string",
            "null"
          ]
        },
        "model_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "inference_backend": {
          "type": [
            "string",
            "null"
          ]
        },
        "backend_version": {
          "type": [
            "string",
            "null"
          ]
        },
        "accelerator": {
          "type": [
            "string",
            "null"
          ]
        },
        "cuda_version": {
          "type": [
            "string",
            "null"
          ]
        },
        "driver_version": {
          "type": [
            "string",
            "null"
          ]
        },
        "deployment_target": {
          "type": [
            "string",
            "null"
          ]
        },
        "verified_at": {
          "type": [
            "string",
            "null"
          ]
        },
        "evidence_reference": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "evidence_policy": {
      "type": "object",
      "required": [
        "required",
        "verification_status"
      ],
      "properties": {
        "required": {
          "type": "boolean"
        },
        "verification_status": {
          "type": "string",
          "enum": [
            "UNKNOWN",
            "NOT VERIFIED",
            "PARTIALLY VERIFIED",
            "VERIFIED",
            "FULLY VERIFIED"
          ]
        },
        "evidence_reference": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
